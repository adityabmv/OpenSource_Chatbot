# .env.example - Backend environment configuration
# Copy this file to .env and update the values for your deployment

# Environment (development, production, etc.)
ENVIRONMENT=development

# Backend server configuration
HOST=0.0.0.0
PORT=8000

# Frontend URL for CORS (comma-separated list)
# For remote deployment, add your frontend URL here
# Example: FRONTEND_URLS=http://yourdomain.com:3000,https://yourdomain.com:3000
FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:30000

# Database configuration
DB_DIR=vector_db

# OpenRouter Configuration
OPENROUTER_API_KEY=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

DEFAULT_MODEL=deepseek/deepseek-r1-0528-qwen3-8b:free
